# ============================================================
# WorldMemArena Eval Framework — Environment Variables
# Copy this file to eval_framework/.env and fill in real values.
# ============================================================

# === Main LLM (answer-stage VLM for all memory baselines) ===
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano

# === Judge LLM (evaluator, can be different provider) ===
OPENAI_API_KEY_JUDGE=your-judge-api-key
OPENAI_BASE_URL_JUDGE=https://api.deepseek.com/v1
OPENAI_MODEL_JUDGE=deepseek-v4-flash

# === HuggingFace model cache ===
# Set this if the default ~/.cache/huggingface is on a partition with limited space.
HF_HOME=/path/to/hf_cache
HUGGINGFACE_HUB_CACHE=/path/to/hf_cache/hub
HF_HUB_CACHE=/path/to/hf_cache/hub
TRANSFORMERS_CACHE=/path/to/hf_cache/hub

# === vLLM Python interpreter ===
# Point to the Python environment that has vllm installed.
VLLM_PYTHON=/path/to/envs/vllm/bin/python

# ============================================================
# GPU Embedding Servers (required by baselines 8-10 only)
# Start these servers before running AUGUSTUSMemory,
# Qwen3-VL-Embedding-8B, or UniversalRAGMemory.
# ============================================================

# --- Qwen3-VL-Embedding-8B server (port 8013) ---
# Used by: Qwen3-VL-Embedding-8B baseline
QWEN_VL_EMBED_BASE_URL=http://127.0.0.1:8013/v1
QWEN_VL_EMBED_API_KEY=EMPTY
QWEN_VL_EMBED_MODEL=Qwen3-VL-Embedding-8B
QWEN_VL_EMBED_MODEL_PATH=/path/to/hf_cache/hub/models--Qwen--Qwen3-VL-Embedding-8B/snapshots/<hash>
QWEN_VL_EMBED_HOST=0.0.0.0
QWEN_VL_EMBED_PORT=8013
QWEN_VL_EMBED_TP=1
QWEN_VL_EMBED_DP=1
QWEN_VL_EMBED_CUDA_VISIBLE_DEVICES=0
QWEN_VL_EMBED_GPU_MEMORY_UTILIZATION=0.45
QWEN_VL_EMBED_MAX_NUM_SEQS=8

# --- GME-Qwen2-VL-2B server (port 8014) ---
# Used by: AUGUSTUSMemory, UniversalRAGMemory
GME_BASE_URL=http://127.0.0.1:8014/v1
GME_API_KEY=EMPTY
GME_MODEL=gme-Qwen2-VL-2B-Instruct
GME_MODEL_PATH=/path/to/hf_cache/hub/models--Alibaba-NLP--gme-Qwen2-VL-2B-Instruct/snapshots/<hash>
GME_HOST=0.0.0.0
GME_PORT=8014
GME_CUDA_VISIBLE_DEVICES=1
GME_TP=1
GME_GPU_MEMORY_UTILIZATION=0.40
GME_MAX_NUM_SEQS=8

# ============================================================
# Harness Baselines (External Tools)
# Required only for Harness-OpenClaw and Harness-Codex.
# ============================================================

# OpenClaw runner path (update after installing OpenClaw)
# OPENCLAW_RUNNER=/path/to/OpenClaw_General/run_openclaw_general.py

# Codex home directory
# CODEX_HOME=~/.codex
